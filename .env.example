# Kizuna Alert AI - Environment Variables

# Google Gemini API Key (Server-side only)
# Used for /api/briefing, /api/scan-hazard, and /api/voice-assist
GEMINI_API_KEY=your_gemini_api_key_here

# Google Maps Platform API Key (Client-side)
# Required APIs enabled: Maps JavaScript API, Places API, Geocoding API, Elevation API
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Optional: Port configuration for Cloud Run (Default: 8080)
PORT=8080
HOST=0.0.0.0
