# Kizuna Alert AI - Environment Variables

# ==============================================================================
# OPTION 1: Google Cloud Vertex AI (RECOMMENDED TO USE GCP FREE CREDITS)
# ==============================================================================
# Set to 'true' to route all Gemini requests through Vertex AI in Google Cloud.
# This directly consumes your GCP Free Credits ($300 trial / hackathon credits)
# and NEVER directly charges your personal credit card.
USE_VERTEX_AI=true
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1
# Model choice: gemini-2.5-flash (or gemini-1.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Authentication for Vertex AI:
# 1. On local machine: Run `gcloud auth application-default login` once in your terminal.
#    (No key needed in this file! It uses your gcloud credentials automatically).
# 2. Or if using a Service Account JSON file:
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# ==============================================================================
# OPTION 2: Google AI Studio (Developer API Key)
# ==============================================================================
# Only used if USE_VERTEX_AI is false or GOOGLE_CLOUD_PROJECT is empty.
GEMINI_API_KEY=your_gemini_api_key_here

# ==============================================================================
# Google Maps Platform (Client-Side)
# ==============================================================================
# Required APIs enabled: Maps JavaScript API, Places API, Geocoding API, Elevation API
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Cloud Run deployment configuration
PORT=8080
HOST=0.0.0.0
